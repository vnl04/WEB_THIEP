flowchart TD
    subgraph S1["1. Tài khoản"]
        A1[Vào trang Đăng ký/Đăng nhập] --> A2{Đã có tài khoản?}
        A2 -- Chưa --> A3[Đăng ký: email/SĐT/Google/Facebook + xác thực OTP]
        A2 -- Rồi --> A4[Đăng nhập, hỗ trợ Quên mật khẩu]
        A3 --> A5[Vào Trang chủ]
        A4 --> A5
    end

    subgraph S2["2. Tìm & chọn mẫu thiệp"]
        A5 --> B1[Tìm kiếm theo từ khoá / Lọc theo phong cách, màu sắc, gói Free-Basic-Premium]
        B1 --> B2[Sắp xếp: Phổ biến / Mới nhất]
        B2 --> B3[Xem preview nhanh từng mẫu]
        B3 --> B4[Chọn mẫu ưng ý]
    end

    subgraph S3["3. Canvas Editor - chỉnh sửa trực tiếp"]
        B4 --> C1[Nhập thông tin: tên cô dâu chú rể, ngày giờ, địa điểm]
        C1 --> C2[Viết câu chuyện tình yêu, upload album ảnh/video/nhúng YouTube]
        C2 --> C3[Chọn nhạc nền + hiệu ứng trang trí]
        C3 --> C4[Click sửa chữ/ảnh trực tiếp trên canvas, kéo-thả vị trí, đổi màu/font]
        C4 --> C5[Kéo-thả sắp xếp lại thứ tự các khối nội dung]
        C5 --> C6{Mời người đồng chỉnh sửa?}
        C6 -- Có --> C7[Gửi lời mời qua email, cấp quyền truy cập chung Editor]
        C6 -- Không --> C8[Thêm danh sách khách mời + bật cá nhân hoá tên, import CSV]
        C7 --> C8
        C8 --> C9[Thiết lập nhận mừng cưới: QR chuyển khoản / quà tặng ảo]
    end

    subgraph S4["4. Xuất bản & chia sẻ"]
        C9 --> D1{Chọn gói dịch vụ}
        D1 -- Free --> D2[Xuất bản: có watermark, giới hạn lượt xem/thời hạn]
        D1 -- Trả phí --> D3[Chuyển sang Luồng Thanh toán] --> D2
        D2 --> D4{Tuỳ chỉnh slug link riêng?}
        D4 -- Có --> D5[Kiểm tra & đặt slug, VD tenweb.vn/minhvalan]
        D4 -- Không --> D6[Dùng link mặc định]
        D5 --> D7
        D6 --> D7[Hệ thống tự sinh thẻ Open Graph: ảnh bìa + tiêu đề khi dán link lên MXH]
        D7 --> D8[Tạo mã QR, chia sẻ qua Zalo/Facebook/Messenger/SMS]
        D8 --> D9[Chuyển sang Luồng Khách mời tương tác]
    end

{
  "name": "wedding-card-platform",
  "version": "1.0.0",
  "description": "Wedding card platform with editor, RSVP, and gift management",
  "private": true,
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "cd apps/api && npx prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "next": "^16.2.10",
    "passport-jwt": "^4.0.1",
    "react": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  }
}

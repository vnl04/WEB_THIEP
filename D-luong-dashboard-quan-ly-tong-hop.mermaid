flowchart TD
    subgraph S1["1. Vào Dashboard"]
        A1[Đăng nhập] --> A2[Vào Dashboard, xem danh sách thiệp đã tạo]
        A2 --> A3{Chọn thao tác}
    end

    subgraph S2["2. Quản lý nội dung & khách mời"]
        A3 -- Chỉnh sửa thiệp --> B1[Mở lại Canvas Editor]
        A3 -- Quản lý khách mời --> B2[Thêm/sửa/xoá, import CSV, xem trạng thái gửi/xem/RSVP]
        A3 -- Quản lý lời chúc --> B3[Duyệt/ẩn/xoá/ghim lời chúc]
        A3 -- Xem thống kê --> B4[Lượt xem, lượt thích, tỉ lệ RSVP]
    end

    subgraph S3["3. Quản lý mừng cưới"]
        A3 -- Ví mừng cưới --> C1[Xem tổng quà đã nhận]
        C1 --> C2[Yêu cầu rút tiền]
        C2 --> C3{Đã xác minh ngân hàng/KYC?}
        C3 -- Chưa --> C4[Nhập & xác minh thông tin ngân hàng]
        C4 --> C3
        C3 -- Rồi --> C5[Nhập số tiền, hệ thống đối soát trừ phí theo gói]
        C5 --> C6{Admin duyệt?}
        C6 -- Duyệt --> C7[Chuyển khoản, cập nhật trạng thái Đã rút]
        C6 -- Từ chối --> C8[Thông báo lý do]
    end

    subgraph S4["4. Thông báo & tiện ích"]
        A3 -- Cài đặt nâng cao --> D1[Tích hợp Google Analytics/Facebook Pixel]
        A3 -- Sao lưu dữ liệu --> D2[Xuất album, danh sách khách, lời chúc, giao dịch thành file ZIP]
        D2 --> D3[Tải file về máy trước khi thiệp hết hạn]

        E1[Sự kiện hệ thống: RSVP mới / lời chúc mới / có quà / sắp hết lượt xem / sắp hết hạn] --> E2[Gửi thông báo qua Email/SMS/Push trong Dashboard]
        E2 --> A2
    end

    B1 --> F1[Lưu, cập nhật tức thì lên link đã gửi khách]
    B2 --> F1
    B3 --> F1
